{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "prove:server": "node scripts/prove-server.mjs",
    "prove:voice": "node scripts/prove-voice.mjs",
    "prove:fleet": "node scripts/prove-fleet.mjs",
    "prove:shell": "node scripts/prove-shell.mjs",
    "prove:config": "node scripts/prove-config.mjs",
    "prove:sessions": "node scripts/prove-parity-sessions.mjs",
    "prove:forms": "node scripts/prove-parity-forms.mjs",
    "prove:switch": "node scripts/prove-parity-switch.mjs",
    "prove:cmdskill": "node scripts/prove-parity-cmdskill.mjs",
    "prove:diff": "node scripts/prove-parity-diff.mjs",
    "prove:terminal": "node scripts/prove-parity-terminal.mjs",
    "prove:mcp": "node scripts/prove-parity-mcp.mjs",
    "prove:workproj": "node scripts/prove-parity-workproj.mjs",
    "build:audio": "mkdir -p apps/audio-speech-analyzer/bin apps/audio-parakeet/bin && swiftc -O apps/audio-speech-analyzer/src/helper.swift -o apps/audio-speech-analyzer/bin/speech-analyzer && swiftc -O apps/audio-parakeet/src/sim.swift -o apps/audio-parakeet/bin/parakeet",
    "prove:audio": "node scripts/prove-audio.mjs",
    "prove:brain": "node scripts/prove-brain.mjs",
    "dev:main": "npm --workspace apps/main run dev",
    "dev:deck": "npm --workspace apps/deck run dev"
  }
}
